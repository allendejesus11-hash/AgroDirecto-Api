# Copia este archivo a .env y reemplaza los valores.
# Con una BD ya creada, utiliza el MISMO password que configuraste antes.
POSTGRES_USER=postgres
POSTGRES_DB=agrodirecto
POSTGRES_PASSWORD=REEMPLAZA_CON_LA_CONTRASENA_ACTUAL
# Usa un secreto largo y aleatorio; para sesiones existentes, conserva el actual.
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CARACTERES

# Opcional: conservar red y volumen existentes de EC2
# DOCKER_NETWORK_NAME=agrodirecto_agrodirecto-network
# POSTGRES_VOLUME_NAME=agrodirecto_db_data
